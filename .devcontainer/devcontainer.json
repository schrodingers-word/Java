{
  "name": "Banking System (Java 21 + JavaFX)",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgtk-3-0 libxtst6 libxxf86vm1 libgl1 libasound2",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Desktop (noVNC)", "onAutoForward": "notify" }
  },
  "remoteEnv": { "DISPLAY": ":1" },
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  }
}



